node_modules/
exports/

# Timestamped backups written once per server session. The workbook backups were
# always ignored; the progress ones were not, and 33 of them had accumulated.
data/*.backup-*.xlsx
data/*.backup-*.json

# Cloudflare deploy credentials - amir's PERSONAL account. Never commit.
.env
.wrangler/

# The generated cloud build. Everything in it comes from web/, src/ and data/.
dist/


# Lecture excerpts are someone else's recording under a share-alike licence.
# The recipe is committed in data/lectures/*.json; the audio stays local.
data/lectures/audio/
data/discussions/audio/

# Your saved answers and their reviews stay in data/attempts.db, which IS
# committed, like progress.json. Its per-session backups are covered above.
data/*.backup-*.db
